<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lets plain http:// media URLs be played while testing. Android blocks
         cleartext by default, and a network source served over http fails with
         an opaque load error rather than anything that names the cause.
         Debug-only on purpose: release builds keep the default and stay
         https-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
